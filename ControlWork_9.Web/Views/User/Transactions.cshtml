@model List<ControWork_9.Models.Transaction>
@using ControWork_9.Models.Enums

@{
    ViewData["Title"] = "Журнал транзакций";
    string userAccount = ViewBag.AccountNumber as string ?? "";
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">
            <i class="bi bi-journal-text me-2 text-primary"></i>Журнал транзакций
        </h4>
        <a asp-controller="Main" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>На главную
        </a>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <form method="get" asp-action="Transactions" class="row g-2 align-items-end">
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-semibold mb-1">Дата с</label>
                    <input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" />
                </div>
                <div class="col-md-4 col-sm-6">
                    <label class="form-label small fw-semibold mb-1">Дата по</label>
                    <input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" />
                </div>
                <div class="col-md-4 col-sm-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1">
                        <i class="bi bi-filter me-1"></i>Применить
                    </button>
                    <a asp-action="Transactions" class="btn btn-outline-secondary">
                        Сбросить
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (Model == null || !Model.Any())
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox fs-1 d-block mb-2 text-secondary"></i>
                    <p class="mb-0">Транзакций за выбранный период не найдено</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-3">Дата и время</th>
                                <th>Тип операции</th>
                                <th>Контрагент</th>
                                <th class="text-end pe-3">Сумма</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                bool isOutgoing = item.FromPersonalNumber == userAccount;
                                <tr>
                                    <td class="ps-3 text-nowrap">
                                        <i class="bi bi-clock me-1 text-muted"></i>
                                        @item.Date.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (item.Type == TransactionTypes.Пополнение)
                                        {
                                            <span class="badge bg-success">
                                                <i class="bi bi-wallet2 me-1"></i>Пополнение
                                            </span>
                                        }
                                        else if (item.Type == TransactionTypes.Перевод)
                                        {
                                            if (isOutgoing)
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-arrow-up-right me-1"></i>Перевод
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-info text-dark">
                                                    <i class="bi bi-arrow-down-left me-1"></i>Входящий перевод
                                                </span>
                                            }
                                        }
                                        else if (item.Type == TransactionTypes.Оплата)
                                        {
                                            <span class="badge bg-warning text-dark">
                                                <i class="bi bi-cart me-1"></i>Оплата
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.Type == TransactionTypes.Пополнение)
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                        else if (item.Type == TransactionTypes.Перевод)
                                        {
                                            if (isOutgoing)
                                            {
                                                <span>Получатель: <strong>#@item.ToPersonalNumber</strong></span>
                                            }
                                            else
                                            {
                                                <span>Отправитель: <strong>#@item.FromPersonalNumber</strong></span>
                                            }
                                        }
                                        else
                                        {
                                            <span>#@item.ToPersonalNumber</span>
                                        }
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        @if (item.Type == TransactionTypes.Пополнение || (!isOutgoing && item.Type == TransactionTypes.Перевод))
                                        {
                                            <span class="text-success fw-bold">
                                                +@item.Amount.ToString("N2") сом
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-bold">
                                                -@item.Amount.ToString("N2") сом
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
