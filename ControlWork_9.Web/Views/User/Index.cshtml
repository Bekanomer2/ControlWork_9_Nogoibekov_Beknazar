@model ControWork_9.Models.User
@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">
            <i class="bi bi-person-badge me-2 text-primary"></i>Личный кабинет
        </h4>
        <div>
            <a asp-action="Transactions" class="btn btn-primary btn-sm me-2">
                <i class="bi bi-journal-text me-1"></i>Журнал транзакций
            </a>
            <a asp-controller="Main" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>На главную
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-person-lines-fill me-2"></i>Персональные данные
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-sm-row align-items-center mb-4 pb-3 border-bottom text-center text-sm-start">
                        <div class="me-sm-4 mb-3 mb-sm-0">
                            <img src="@(string.IsNullOrEmpty(Model.AvatarUrl) ? "/default.jpg" : Model.AvatarUrl)"
                                 alt="Аватар"
                                 class="rounded-circle border shadow-sm"
                                 style="width: 96px; height: 96px; object-fit: cover;"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.UserName ?? "User")&background=0D6EFD&color=fff';" />
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@Model.UserName</h4>
                            <span class="badge bg-secondary font-monospace fs-6">
                                <i class="bi bi-credit-card-2-front me-1"></i>Личный счет: #@Model.AccountNumber
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-envelope me-1 text-primary"></i>Адрес электронной почты
                                </span>
                                <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.Email) ? "—" : Model.Email)</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-telephone me-1 text-primary"></i>Номер телефона
                                </span>
                                <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "—" : Model.PhoneNumber)</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-shield-check me-1 text-primary"></i>Личный счет
                                </span>
                                <strong class="fs-6 text-dark font-monospace">#@Model.AccountNumber</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-wallet2 me-1 text-success"></i>Текущий баланс
                                </span>
                                <strong class="fs-6 text-success fw-bold">@Model.Balance.ToString("N2") сом</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
