@model ControWork_9.ViewModels.UserProfileViewModel
@using ControWork_9.Models.Enums
@{
    ViewData["Title"] = Localizer["Title"];
}

<div class="py-2">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold mb-0">
            <i class="bi bi-person-badge me-2 text-primary"></i>@Localizer["Header"]
        </h4>
        <div>
            <a asp-action="Transactions" class="btn btn-primary btn-sm me-2">
                <i class="bi bi-journal-text me-1"></i>@Localizer["TransactionsBtn"]
            </a>
            <a asp-controller="Main" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i>@Localizer["ToHomeBtn"]
            </a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-person-lines-fill me-2"></i>@Localizer["PersonalInfoHeader"]
                    </h6>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex flex-column flex-sm-row align-items-center mb-4 pb-3 border-bottom text-center text-sm-start">
                        <div class="me-sm-4 mb-3 mb-sm-0">
                            <img src="@(string.IsNullOrEmpty(Model.User.AvatarUrl) ? "/default.jpg" : Model.User.AvatarUrl)"
                                 alt="Аватар"
                                 class="rounded-circle border shadow-sm"
                                 style="width: 96px; height: 96px; object-fit: cover;"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.User.UserName ?? "User")&background=0D6EFD&color=fff';" />
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">@Model.User.UserName</h4>
                            <span class="badge bg-secondary font-monospace fs-6">
                                <i class="bi bi-credit-card-2-front me-1"></i>@Localizer["AccountBadge"] #@Model.User.AccountNumber
                            </span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-envelope me-1 text-primary"></i>@Localizer["EmailLabel"]
                                </span>
                                <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.User.Email) ? "—" : Model.User.Email)</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-telephone me-1 text-primary"></i>@Localizer["PhoneLabel"]
                                </span>
                                <strong class="fs-6 text-dark">@(string.IsNullOrEmpty(Model.User.PhoneNumber) ? "—" : Model.User.PhoneNumber)</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-shield-check me-1 text-primary"></i>@Localizer["AccountLabel"]
                                </span>
                                <strong class="fs-6 text-dark font-monospace">#@Model.User.AccountNumber</strong>
                            </div>
                        </div>

                        <div class="col-sm-6">
                            <div class="p-3 bg-light rounded-3">
                                <span class="text-muted small d-block">
                                    <i class="bi bi-wallet2 me-1 text-success"></i>@Localizer["BalanceLabel"]
                                </span>
                                <strong class="fs-6 text-success fw-bold">@Model.User.Balance.ToString("N2") @Localizer["Som"]</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm border-0 mb-3">
                <div class="card-header bg-primary text-white py-2">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-card-checklist me-2"></i>@Localizer["RequisitesHeader"]
                    </h6>
                </div>
                <div class="card-body p-3">
                    @if (!Model.AreAccountsReady)
                    {
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <h5 class="fw-bold text-dark mb-1">@Localizer["PreparingHeader"]</h5>
                            <p class="text-muted small mb-0">@Localizer["PreparingDesc"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>@Localizer["ThProvider"]</th>
                                        <th>@Localizer["ThCategory"]</th>
                                        <th>@Localizer["ThRequisite"]</th>
                                        <th class="text-end">@Localizer["ThBalance"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in Model.ServiceAccounts)
                                    {
                                        <tr>
                                            <td class="fw-bold">
                                                <i class="bi bi-building me-1 text-primary"></i>
                                                @account.Provider?.Name
                                            </td>
                                            <td>
                                                @if (account.Provider?.Category == ProvidersCategories.Mobile)
                                                {
                                                    <span class="badge bg-info text-dark">
                                                        <i class="bi bi-phone me-1"></i>@Localizer["CategoryMobile"]
                                                    </span>
                                                }
                                                else if (account.Provider?.Category == ProvidersCategories.Internet)
                                                {
                                                    <span class="badge bg-secondary">
                                                        <i class="bi bi-wifi me-1"></i>@Localizer["CategoryInternet"]
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark border">
                                                        <i class="bi bi-gear me-1"></i>@Localizer["CategoryUtilities"]
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <span class="font-monospace fw-semibold">@account.AccountNumber</span>
                                            </td>
                                            <td class="text-end fw-bold text-success">
                                                @account.Balance.ToString("N2") @Localizer["Som"]
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @if (!Model.AreAccountsReady)
    {
        <script>
            var checkAccountsInterval = setInterval(function () {
                $.ajax({
                    url: '@Url.Action("GetServiceAccountsStatus", "User")',
                    type: 'GET',
                    success: function (res) {
                        if (res && res.ready) {
                            clearInterval(checkAccountsInterval);
                            location.reload();
                        }
                    }
                });
            }, 2000);
        </script>
    }
}
