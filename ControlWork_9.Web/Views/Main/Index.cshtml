@model ControWork_9.ViewModels.MainIndexViewModel
@{
    ViewData["Title"] = "Главная страница";
}

<div>
    @if (Model.IsAuthenticated && Model.CurrentUser != null)
    {
        <div class="card shadow-sm border-0 mb-3 bg-light">
            <div class="card-body p-3">
                <div class="row align-items-center">
                    <div class="col-md-7 d-flex align-items-center mb-2 mb-md-0">
                        <div class="me-3">
                            <img src="@(string.IsNullOrEmpty(Model.CurrentUser.AvatarUrl) ? "/default.jpg" : Model.CurrentUser.AvatarUrl)"
                                 alt="Аватар"
                                 class="rounded-circle border"
                                 style="width: 56px; height: 56px; object-fit: cover;"
                                 onerror="this.src='https://ui-avatars.com/api/?name=@Uri.EscapeDataString(Model.CurrentUser.UserName ?? "User")&background=0D6EFD&color=fff';" />
                        </div>
                        <div>
                            <span class="badge bg-primary mb-1">
                                <i class="bi bi-person-check me-1"></i>Личный кабинет
                            </span>
                            <h5 class="mb-1 fw-bold">@Model.CurrentUser.UserName</h5>
                            <div class="text-muted small">
                                Личный счет: <strong class="badge bg-secondary font-monospace">@Model.CurrentUser.AccountNumber</strong>
                            </div>
                            <div class="mt-2 d-flex gap-2">
                                <a asp-controller="User" asp-action="Index" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-person me-1"></i>Личный кабинет
                                </a>
                                <a asp-controller="User" asp-action="Transactions" class="btn btn-outline-secondary btn-sm">
                                    <i class="bi bi-clock-history me-1"></i>Журнал транзакций
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5">
                        <div class="p-2 px-3 bg-white rounded-3 shadow-sm border text-md-end text-start">
                            <div class="text-muted small text-uppercase fw-semibold">
                                <i class="bi bi-wallet2 me-1 text-success"></i>Текущий баланс
                            </div>
                            <div class="fs-4 fw-bold text-success mb-0">
                                <span id="userBalance">@Model.CurrentUser.Balance.ToString("N2")</span> <span class="fs-6 text-muted">сом</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 mb-3 bg-light text-center py-3">
            <div class="card-body p-2">
                <h4 class="fw-bold text-primary mb-1">Добро пожаловать в платёжный сервис!</h4>
                <p class="text-muted small mb-2">
                    Авторизуйтесь, чтобы узнать баланс своего счета, или пополните счет любого пользователя ниже.
                </p>
                <div>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm px-3 me-2">
                        <i class="bi bi-box-arrow-in-right me-1"></i>Вход
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-sm px-3">
                        <i class="bi bi-person-plus me-1"></i>Регистрация
                    </a>
                </div>
            </div>
        </div>
    }

    <div class="row @(Model.IsAuthenticated ? "" : "justify-content-center")">
        <div class="@(Model.IsAuthenticated ? "col-lg-6" : "col-lg-6 col-md-8") mb-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-success text-white py-2">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-wallet2 me-2"></i>Пополнение счета
                    </h6>
                </div>
                <div class="card-body p-3">
                    <form id="replenishForm">
                        <div class="mb-2">
                            <label class="form-label small fw-semibold mb-1">Номер личного счета</label>
                            <input type="text"
                                   name="toPersonalNumber"
                                   class="form-control"
                                   placeholder="Введите 6 цифр"
                                   required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-semibold mb-1">Сумма пополнения (сом)</label>
                            <input type="number"
                                   name="amount"
                                   class="form-control"
                                   placeholder="Введите сумму"
                                   min="1"
                                   step="any"
                                   required />
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-success fw-bold py-2">
                                <i class="bi bi-check-circle me-1"></i>Пополнить
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        @if (Model.IsAuthenticated)
        {
            <div class="col-lg-6 mb-3">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-primary text-white py-2">
                        <h6 class="mb-0 fw-bold">
                            <i class="bi bi-arrow-left-right me-2"></i>Перевод средств
                        </h6>
                    </div>
                    <div class="card-body p-3">
                        <form id="transferForm">
                            <div class="mb-2">
                                <label class="form-label small fw-semibold mb-1">Номер счета получателя</label>
                                <input type="text"
                                       name="toPersonalNumber"
                                       class="form-control"
                                       placeholder="Введите 6 цифр получателя"
                                       required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-semibold mb-1">Сумма перевода (сом)</label>
                                <input type="number"
                                       name="amount"
                                       class="form-control"
                                       placeholder="Введите сумму перевода"
                                       min="1"
                                       step="any"
                                       required />
                            </div>

                            <div class="d-grid">
                                <button type="submit" class="btn btn-primary fw-bold py-2">
                                    <i class="bi bi-send me-1"></i>Перевести
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function updateBalance() {
            $.ajax({
                url: '@Url.Action("GetBalance", "User")',
                type: 'GET',
                success: function (data) {
                    if (data.isAuthenticated) {
                        $('#userBalance').text(Number(data.balance).toFixed(2));
                    }
                }
            });
        }

        @if (Model.IsAuthenticated)
        {
            <text>
            setInterval(updateBalance, 5000);
            </text>
        }

        $('#replenishForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("AccountReplenishment", "User")',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    alert(response.message);
                    if (response.success) {
                        $('#replenishForm')[0].reset();
                        updateBalance();
                    }
                },
                error: function () {
                    alert('Произошла ошибка при отправке запроса');
                }
            });
        });

        $('#transferForm').on('submit', function (e) {
            e.preventDefault();

            $.ajax({
                url: '@Url.Action("TransferMoney", "User")',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    alert(response.message);
                    if (response.success) {
                        $('#transferForm')[0].reset();
                        updateBalance();
                    }
                },
                error: function () {
                    alert('Произошла ошибка при отправке запроса');
                }
            });
        });
    </script>
}
